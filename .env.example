# Copy to .env (git-ignored). Local-only defaults for a native PostgreSQL 18 installation
# (no containers, ADR-021); never use them outside local development.
# Bootstrap once: make db-init  (or .\scripts\dev.ps1 db-init), then make migrate-up.

# Process configuration
KAPSORA_ENV=local
KAPSORA_LOG_LEVEL=debug
KAPSORA_HTTP_ADDR=:8080
KAPSORA_DB_MAX_CONNS=10

# Application role: subject to RLS, owns nothing.
KAPSORA_DATABASE_URL=postgres://kapsora_app:kapsora_app_local@localhost:5432/kapsora?sslmode=disable

# Schema owner used by `migrate up` (bypasses RLS as owner/superuser; never used by the API).
KAPSORA_MIGRATE_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kapsora?sslmode=disable

# Schema tests (db/tests) and db-init: a role that can CREATE DATABASE and CREATE ROLE on a
# PostgreSQL 18 instance (usually the postgres superuser locally). Tests create and drop
# throw-away databases named kapsora_test_* and set the kapsora_app password below.
KAPSORA_TEST_ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres?sslmode=disable
KAPSORA_TEST_APP_PASSWORD=kapsora_app_local

# Field encryption master key for local/pilot runs (64 hex chars). Generate one with
#   go run ./cmd/keygen   or any 32 random bytes in hex.
KAPSORA_LOCAL_MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Derives the per-session CSRF token (64 hex chars). Required by kapsora-api;
# `go run ./cmd/keygen` prints one.
KAPSORA_COOKIE_SIGNING_KEY=CHANGE_ME_64_HEX_CHARACTERS

# Session cookie and lifetimes (ADR-022). Secure=false is only accepted in the local and
# test environments; it drops the __Host- cookie prefix so plain HTTP works.
KAPSORA_COOKIE_SECURE=false
KAPSORA_SESSION_IDLE_MINUTES=30
KAPSORA_SESSION_ABSOLUTE_HOURS=8
KAPSORA_STEP_UP_MINUTES=10

# --- native dependencies started by scripts/native/up.* (local only) ------------------
# MinIO (S3 compatible object store); root credentials are for the local instance only.
KAPSORA_MINIO_ADDR=127.0.0.1:9000
KAPSORA_MINIO_CONSOLE_ADDR=127.0.0.1:9001
KAPSORA_MINIO_ROOT_USER=kapsora
KAPSORA_MINIO_ROOT_PASSWORD=kapsora_local_minio
# ClamAV daemon (clamd TCP socket)
KAPSORA_CLAMAV_ADDR=127.0.0.1:3310

# Documents (WP-I4-04). A file never reaches the API or the database: the client uploads
# into `quarantine` through a presigned PUT, the worker streams it to clamd, and only a
# clean file is copied to `secure`. Both URL lifetimes are short because a presigned URL is
# a bearer credential. Retention is disabled by default — purging real documents after a
# number nobody chose would be worse than keeping them — and a document under legal hold is
# never purged whatever it says.
KAPSORA_DOCUMENT_QUARANTINE_BUCKET=quarantine
KAPSORA_DOCUMENT_SECURE_BUCKET=secure
KAPSORA_DOCUMENT_UPLOAD_URL_MINUTES=15
KAPSORA_DOCUMENT_DOWNLOAD_URL_MINUTES=5
KAPSORA_DOCUMENT_SCAN_TIMEOUT_SECONDS=120
KAPSORA_DOCUMENT_ENCRYPTION_KEY_REF=objectstore:default
KAPSORA_DOCUMENT_RETENTION_DAYS=0
# Mailpit: web UI and the SMTP endpoint the notification module will use
KAPSORA_MAILPIT_UI_ADDR=127.0.0.1:8025
KAPSORA_SMTP_ADDR=127.0.0.1:1025
