# Copy to .env (git-ignored). Values below match docker-compose.yml; never use them
# outside local development.

# Process configuration
KAPSORA_ENV=local
KAPSORA_LOG_LEVEL=debug
KAPSORA_HTTP_ADDR=:8080
KAPSORA_DB_MAX_CONNS=10

# Application role: subject to RLS, owns nothing.
KAPSORA_DATABASE_URL=postgres://kapsora_app:kapsora_app_local@localhost:5432/kapsora?sslmode=disable

# Schema owner used by `migrate up` (bypasses RLS as owner/superuser; never used by the API).
KAPSORA_MIGRATE_DATABASE_URL=postgres://kapsora_owner:kapsora_owner_local@localhost:5432/kapsora?sslmode=disable

# Schema tests (db/tests): a role that can CREATE DATABASE and CREATE ROLE on a PostgreSQL 18
# instance. Tests create and drop throw-away databases named kapsora_test_*.
KAPSORA_TEST_ADMIN_DATABASE_URL=postgres://kapsora_owner:kapsora_owner_local@localhost:5432/postgres?sslmode=disable
