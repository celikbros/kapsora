# /etc/systemd/system/kapsora-scheduler.service
[Unit]
Description=KAPSORA scheduler (single leader via PostgreSQL advisory lock)
Documentation=https://github.com/celikbros/kapsora
After=network-online.target postgresql.service kapsora-migrate.service
Wants=network-online.target kapsora-migrate.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Restart=on-failure
RestartSec=3s
TimeoutStopSec=60s
KillSignal=SIGTERM
WorkingDirectory=/opt/kapsora
ExecStart=/opt/kapsora/bin/scheduler
EnvironmentFile=/etc/kapsora/api.env
Environment=KAPSORA_ENV=production

User=kapsora
Group=kapsora
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=65536
StateDirectory=kapsora
LogsDirectory=kapsora
ReadWritePaths=/var/lib/kapsora

[Install]
WantedBy=multi-user.target
