# /etc/systemd/system/minio.service
# MinIO object store as a native process, only when the customer has no S3-compatible store.
# Binary /opt/minio/bin/minio: version and SHA-256 pinned in scripts/native/versions.json.
# Credentials: /etc/minio/minio.env with MINIO_ROOT_USER / MINIO_ROOT_PASSWORD (0600 root:minio).
[Unit]
Description=MinIO object store
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=minio
Group=minio
EnvironmentFile=/etc/minio/minio.env
Environment=MINIO_BROWSER_REDIRECT=false
ExecStart=/opt/minio/bin/minio server /var/lib/minio --address 127.0.0.1:9000 --console-address 127.0.0.1:9001
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/minio
TasksMax=infinity

[Install]
WantedBy=multi-user.target
